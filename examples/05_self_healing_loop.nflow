@description "Chapter 5: Autonomous test-fix loop inside the sandbox"

@require github.com/nexssp/sandbox/nexssflow as sb {
    engine: "inprocess",
    workspace: ".sandbox_05",
    enforce_policy: false
}

@assert: result.passed == true
@assert: result.attempt == 2

# Initial state: attempt 1 with a syntax bug
{
    attempt: 1,
    command: "node",
    args: ["worker.js"],
    files: {
        "worker.js": "console.log('Fixed on attempt ' + 2);"
    }
}
-> loop(
    # Run in sandbox
    sb.exec
    # Project state and simulate a self-repairing agent on retry
    -> {
        ...,
        attempt: .attempt + 1,
        command: "node",
        args: ["worker.js"]
    }
) until( .passed == true || .attempt >= 3 )
