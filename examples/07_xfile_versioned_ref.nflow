@description "Chapter 7: Verify a versioned storage file before sandbox execution"
@require github.com/nexssp/sandbox/nexssflow as sb {
    engine: "inprocess",
    workspace: ".sandbox_07",
    image: "alpine:latest",
    allowed_executables: "cat"
}
@assert: result.passed == true
@assert: result.stdout == "embedded invoice payload\n"
# A host must inject an authorized resolver or register its provider bundle in the Flow runner.
# The files-map object is the BlobRef (xfile.Ref); these are integrity constraints.
# inprocess runs commands on the host and does not provide production isolation.
{
    command: "cat",
    args: ["invoice"],
    files: {
        invoice: {
            Provider: "demo-store",
            ID: "invoice-2026-10",
            Version: "v3",
            ExpectedSize: 25,
            ExpectedDigest: "sha256:b478bcf1cff7c939ef1b4d101d774897d3d92af56a593c1b72cc66e963ccdc01"
        }
    }
} -> sb.exec
