@description "Run formatting, unit tests, and vet against an injected Go billing module"

@symbols gate {
    passed: "quality-gate-passed"
}

@require github.com/nexssp/sandbox/nexssflow as sb {
    engine: "inprocess",
    workspace: "../sandbox/.sandbox_go_quality_gate",
    enforce_policy: "true"
}

# The image is descriptive only with inprocess; commands run on the host.
@sandbox review {
    image: "golang:1.26-alpine",
    memory_mb: 1024,
    cpus: 1.0,
    pids_limit: 64,
    network_mode: "none",
    allowed_executables: "gofmt, go"
}

# One named workspace keeps the injected Go module available across all three
# steps. Every failed command fails the pipeline immediately.
@pipeline quality_gate
    {
        command: "gofmt",
        args: ["-w", "amount.go", "amount_test.go"],
        timeout_seconds: 30,
        files: {
            "go.mod": "module example.com/billing/amounts\n\ngo 1.23.0\n",
            "amount.go": "package amounts\n\nimport (\n    \"errors\"\n    \"math\"\n)\n\nvar ErrInvalidLine = errors.New(\"invalid invoice line\")\nvar ErrOverflow = errors.New(\"invoice total overflows int64\")\n\ntype Line struct {\n    SKU string\n    UnitPriceCents int64\n    Quantity int\n}\n\nfunc SubtotalCents(lines []Line) (int64, error) {\n    var total int64\n    for _, line := range lines {\n        if line.SKU == \"\" || line.UnitPriceCents < 0 || line.Quantity <= 0 {\n            return 0, ErrInvalidLine\n        }\n        quantity := int64(line.Quantity)\n        if line.UnitPriceCents > math.MaxInt64/quantity {\n            return 0, ErrOverflow\n        }\n        lineTotal := line.UnitPriceCents * quantity\n        if total > math.MaxInt64-lineTotal {\n            return 0, ErrOverflow\n        }\n        total += lineTotal\n    }\n    return total, nil\n}\n",
            "amount_test.go": "package amounts\n\nimport (\n    \"errors\"\n    \"testing\"\n)\n\nfunc TestSubtotalCents(t *testing.T) {\n    got, err := SubtotalCents([]Line{\n        {SKU: \"SKU-100\", UnitPriceCents: 1250, Quantity: 2},\n        {SKU: \"SKU-200\", UnitPriceCents: 499, Quantity: 3},\n    })\n    if err != nil {\n        t.Fatalf(\"SubtotalCents returned error: %v\", err)\n    }\n    if want := int64(3997); got != want {\n        t.Fatalf(\"SubtotalCents = %d, want %d\", got, want)\n    }\n}\n\nfunc TestSubtotalRejectsInvalidInvoiceLine(t *testing.T) {\n    _, err := SubtotalCents([]Line{{SKU: \"\", UnitPriceCents: 100, Quantity: 1}})\n    if !errors.Is(err, ErrInvalidLine) {\n        t.Fatalf(\"error = %v, want %v\", err, ErrInvalidLine)\n    }\n}\n\nfunc TestSubtotalRejectsOverflow(t *testing.T) {\n    _, err := SubtotalCents([]Line{{SKU: \"SKU-OVERFLOW\", UnitPriceCents: 1<<62, Quantity: 3}})\n    if !errors.Is(err, ErrOverflow) {\n        t.Fatalf(\"error = %v, want %v\", err, ErrOverflow)\n    }\n}\n"
        }
    } -> sb.review
    -> match {
        .passed == true -> {
            stage: "formatted",
            exit_code: .exit_code,
            stdout: .stdout
        },
        _ -> fail @{ kind: "Validation", message: .stderr }
    }
    -> {
        command: "go",
        args: ["test", "./..."],
        timeout_seconds: 60
    } -> sb.review
    -> match {
        .passed == true -> {
            stage: "tests-passed",
            exit_code: .exit_code,
            stdout: .stdout
        },
        _ -> fail @{ kind: "Validation", message: .stderr }
    }
    -> {
        command: "go",
        args: ["vet", "./..."],
        timeout_seconds: 60
    } -> sb.review
    -> match {
        .passed == true -> {
            status: gate.passed,
            checks: ["gofmt", "go test ./...", "go vet ./..."],
            final_exit_code: .exit_code,
            final_stdout: .stdout
        },
        _ -> fail @{ kind: "Validation", message: .stderr }
    }
@end

@assert: result.status == gate.passed
@assert: result.final_exit_code == 0

{} -> pipeline.quality_gate
