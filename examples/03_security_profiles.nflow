@description "Chapter 3: Named profile policy checks (in-process execution is not OS/container isolation)"

@require github.com/nexssp/sandbox/nexssflow as sb {
    engine: "inprocess",
    workspace: ".sandbox_03",
    enforce_policy: true
}

# Define a policy-checked profile. The in-process engine does not enforce host isolation or container resource limits.
@sandbox secureRunner {
    image: "alpine:latest",
    memory_mb: 256,
    cpus: 1.0,
    pids_limit: 32,
    network_mode: "none",
    allowed_executables: "python,node,ls"
}

@assert: result.passed == true

# Attempting to call an executable not listed in 'allowed_executables' will be rejected by the security policy.
{
    command: "python",
    args: ["-c", "import os; print('Running with policy-checked profile (in-process):', os.name)"]
} -> sb.secureRunner
