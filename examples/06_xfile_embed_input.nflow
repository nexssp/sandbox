@description "Chapter 6: Stage a host-supplied Storage BlobRef"
@require github.com/nexssp/sandbox/nexssflow as sb {
    engine: "inprocess",
    workspace: ".sandbox_06",
    image: "alpine:latest",
    allowed_executables: "cat"
}
@assert: result.passed == true
@assert: result.stdout == "embedded invoice payload\n"
# This request uses a host-authorized Storage BlobRef and an injected resolver.
# The files.invoice value is an xfile.Ref, not inline bytes or a workspace path.
# The Flow v0.28.1 @embed + Storage combination is exercised in nexssflow/end_to_end_test.go.
# inprocess executes `cat` directly on the host: use only for trusted demos; it is not isolation.
{
    command: "cat",
    args: ["invoice"],
    files: {
        invoice: {
            Provider: "demo-store",
            ID: "invoice-2026-10",
            Version: "v1",
            ExpectedSize: 25,
            ExpectedDigest: "sha256:b478bcf1cff7c939ef1b4d101d774897d3d92af56a593c1b72cc66e963ccdc01"
        }
    }
} -> sb.exec
