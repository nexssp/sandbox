@description "Chapter 4: Parallel multi-language matrix execution"

@require github.com/nexssp/sandbox/nexssflow as sb {
    engine: "inprocess",
    workspace: ".sandbox_04",
    enforce_policy: false
}

# Run both sandbox tasks concurrently across different language environments
(
    {
        command: "node",
        args: ["-e", "console.log(JSON.stringify({runtime: 'node', version: process.version}))"]
    } -> sb.exec
    &
    {
        command: "python",
        args: ["-c", "import sys, json; print(json.dumps({'runtime': 'python', 'version': sys.version.split()[0]}))"]
    } -> sb.exec
)
