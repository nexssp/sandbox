@description "Reconcile AP invoices against approved purchase orders and route exceptions"

@symbols ap {
    clear: "CLEAR"
    needs_review: "NEEDS_REVIEW"
    posting_queue: "finance-posting"
    review_queue: "ap-exceptions"
    report_file: "reconciliation-report.json"
}

@require github.com/nexssp/sandbox/nexssflow as sb {
    engine: "inprocess",
    workspace: "../sandbox/.sandbox_invoice_reconciliation",
    enforce_policy: "true"
}

# The image records the intended worker runtime. The inprocess engine ignores it
# and launches Python on the host; this example is for trusted local inputs only.
@sandbox ap_worker {
    image: "python:3.12-alpine",
    memory_mb: 512,
    cpus: 1.0,
    pids_limit: 32,
    network_mode: "none",
    allowed_executables: "python"
}

@assert: result.status == ap.needs_review
@assert: result.queue == ap.review_queue
@assert: result.report_path == ap.report_file

{
    command: "python",
    args: ["reconcile.py", ap.clear, ap.needs_review, ap.report_file],
    timeout_seconds: 30,
    files: {
        "purchase_orders.csv": "po_number,vendor,currency,open_amount\nPO-501,Harbor Supply,PLN,12000.00\nPO-502,Metro IT,EUR,1800.00\nPO-503,Cedar Office,PLN,500.00\n",
        "invoices.csv": "invoice_id,po_number,vendor,currency,amount\nINV-9001,PO-501,Harbor Supply,PLN,4750.00\nINV-9002,PO-501,Harbor Supply,PLN,2800.00\nINV-9003,PO-502,Metro IT,EUR,1900.00\nINV-9004,PO-799,Northstar Parts,PLN,300.00\nINV-9005,PO-503,Other Vendor,PLN,490.00\nINV-9001,PO-501,Harbor Supply,PLN,100.00\n",
        "reconcile.py": "import csv, json\nimport sys\nfrom collections import defaultdict\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path\n\nclear_status, review_status, report_path = sys.argv[1:4]\n\ndef read_rows(path):\n    with Path(path).open(newline='', encoding='utf-8') as handle:\n        return list(csv.DictReader(handle))\n\norders = {}\nfor row in read_rows('purchase_orders.csv'):\n    po_number = row['po_number']\n    if po_number in orders:\n        raise ValueError('duplicate purchase order: ' + po_number)\n    orders[po_number] = row\n\nseen = set()\ncommitted = defaultdict(Decimal)\naccepted = []\nexceptions = []\ntotals = defaultdict(Decimal)\nfor invoice in read_rows('invoices.csv'):\n    invoice_id = invoice['invoice_id'].strip()\n    po_number = invoice['po_number'].strip()\n    currency = invoice['currency'].strip()\n    reasons = []\n    if not invoice_id:\n        reasons.append('missing_invoice_id')\n    elif invoice_id in seen:\n        reasons.append('duplicate_invoice_id')\n    else:\n        seen.add(invoice_id)\n    try:\n        amount = Decimal(invoice['amount'])\n        if not amount.is_finite() or amount <= 0:\n            reasons.append('amount_must_be_positive')\n            amount = None\n    except InvalidOperation:\n        reasons.append('invalid_amount')\n        amount = None\n    po = orders.get(po_number)\n    if po is None:\n        reasons.append('purchase_order_not_found')\n    else:\n        if invoice['vendor'].strip() != po['vendor']:\n            reasons.append('vendor_mismatch')\n        if currency != po['currency']:\n            reasons.append('currency_mismatch')\n        if amount is not None:\n            open_amount = Decimal(po['open_amount'])\n            if committed[po_number] + amount > open_amount:\n                reasons.append('purchase_order_limit_exceeded')\n    if reasons:\n        exceptions.append({'invoice_id': invoice_id, 'po_number': po_number, 'reasons': reasons})\n    else:\n        committed[po_number] += amount\n        accepted.append(invoice_id)\n        totals[currency] += amount\n\nstatus = review_status if exceptions else clear_status\nreport = {\n    'status': status,\n    'accepted_invoice_ids': accepted,\n    'accepted_totals_by_currency': {key: format(value, 'f') for key, value in sorted(totals.items())},\n    'exceptions': exceptions,\n}\nPath(report_path).write_text(json.dumps(report, indent=2, sort_keys=True), encoding='utf-8')\nprint(status, end='')"
    }
} -> sb.ap_worker
-> match {
    .stdout == ap.clear -> {
        status: ap.clear,
        queue: ap.posting_queue,
        report_path: ap.report_file,
        worker_stdout: .stdout,
        worker_exit_code: .exit_code
    },
    .stdout == ap.needs_review -> {
        status: ap.needs_review,
        queue: ap.review_queue,
        report_path: ap.report_file,
        worker_stdout: .stdout,
        worker_exit_code: .exit_code
    },
    _ -> fail @{ kind: "Internal", message: .stderr }
}
